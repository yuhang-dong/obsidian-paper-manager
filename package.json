{
	"name": "paper-manager",
	"version": "0.1.0",
	"description": "An Obsidian plugin for managing and synthesizing academic papers.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "concurrently --kill-others-on-fail \"npm:dev:js\" \"npm:dev:css\"",
		"dev:js": "node esbuild.config.mjs",
		"dev:css": "tailwindcss -i src/styles.css -o styles.css --watch",
		"dev:obsidian": "npm run build:css && concurrently --kill-others-on-fail \"node scripts/dev-local.mjs\" \"npm:dev:css\"",
		"build": "tsc -noEmit -skipLibCheck && npm run build:js && npm run build:css",
		"build:js": "node esbuild.config.mjs production",
		"build:css": "tailwindcss -i src/styles.css -o styles.css --minify",
		"build:obsidian": "npm run build && node scripts/deploy-local.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint ."
	},
	"keywords": [
		"obsidian",
		"academic-papers",
		"pdf"
	],
	"license": "UNLICENSED",
	"devDependencies": {
		"@codemirror/state": "^6.5.0",
		"@codemirror/view": "^6.38.6",
		"@eslint/js": "^9.39.4",
		"@tailwindcss/cli": "^4.3.3",
		"@types/node": "^22.15.17",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"concurrently": "^10.0.4",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"shadcn": "^4.16.2",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	},
	"dependencies": {
		"@embedpdf/core": "^2.14.4",
		"@embedpdf/plugin-annotation": "^2.14.4",
		"@embedpdf/plugin-document-manager": "^2.14.4",
		"@embedpdf/plugin-export": "^2.14.4",
		"@embedpdf/plugin-i18n": "^2.14.4",
		"@embedpdf/react-pdf-viewer": "^2.14.4",
		"@tanstack/react-table": "^9.0.0",
		"ai": "^7.0.56",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"fake-progress": "^1.0.4",
		"lucide-react": "^1.29.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"tailwind-merge": "^3.6.0",
		"zod": "^4.4.3"
	}
}
